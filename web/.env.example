# Public base URL used by client components in browser requests.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Google OAuth Client ID (create at https://console.cloud.google.com/apis/credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional server-side base URL override for server components/actions.
STEADY_API_BASE_URL=http://localhost:3000
